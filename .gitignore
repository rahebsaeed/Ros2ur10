# Secrets — never commit
.env

# Python
.venv/
__pycache__/
*.pyc

# ROS 2 / colcon
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Onshape export cache & raw dumps (regenerable)
export/.cache/
export/inspect/

# Presentation output (generated by scripts/make_pptx.py — regenerate any time)
docs/presentation/*.pptx
docs/presentation/*.pdf
